{
  "name": "process-raid-guild",
  "version": "0.3.0",
  "description": "Turn real computer processes into a cooperative pixel-art raid dashboard.",
  "main": "src/main.js",
  "author": "Hyunwoo Jung",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "node scripts/build-release.js"
  },
  "dependencies": {
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  },
  "build": {
    "appId": "com.processraid.guild",
    "productName": "Process Raid Guild",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Process-Raid-Guild-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
